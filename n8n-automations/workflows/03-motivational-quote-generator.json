{
  "name": "Exercise 3 - Motivational Quote Generator",
  "nodes": [
    {
      "id": "b1",
      "name": "Manual Trigger (Test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -100
      ],
      "parameters": {}
    },
    {
      "id": "b2",
      "name": "Every Day at 7 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      }
    },
    {
      "id": "b3",
      "name": "Generate Quote",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        260,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "Write one original, uplifting motivational quote for today ({{ $now.toFormat('cccc, d LLLL yyyy') }}), followed by one short sentence (max 25 words) on how to apply it today.\nFormat exactly:\n\"<quote>\"\n\n<one-sentence tip>\nNo title, no author name, no extra text."
      }
    },
    {
      "id": "b4",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        260,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.9
        }
      }
    },
    {
      "id": "b5",
      "name": "Get Recipients",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        560,
        0
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "gid=0",
          "cachedResultName": "Sheet1"
        },
        "options": {}
      }
    },
    {
      "id": "b6",
      "name": "Send Quote Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        820,
        0
      ],
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "=Your Daily Motivation – {{ $now.toFormat('d LLL yyyy') }}",
        "emailType": "text",
        "message": "=Good morning {{ $json.Name }},\n\n{{ $('Generate Quote').first().json.text }}\n\nHave a great day!\nSuleman",
        "options": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger (Test)": {
      "main": [
        [
          {
            "node": "Generate Quote",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every Day at 7 AM": {
      "main": [
        [
          {
            "node": "Generate Quote",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Generate Quote",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Generate Quote": {
      "main": [
        [
          {
            "node": "Get Recipients",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Recipients": {
      "main": [
        [
          {
            "node": "Send Quote Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Karachi"
  }
}